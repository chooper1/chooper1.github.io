---
layout: default
---

<style>
.header-content {
  display: flex;
  align-items: flex-start;
  gap: 20px;
}

.title-section {
  flex: 1;
}

.profile-header {
  margin-top: 0;
  flex-shrink: 0;
}

.contact-info {
  margin-top: 10px;
}

.contact-info p {
  margin-bottom: 5px;
  font-size: 0.95rem;
}

.bio-text {
  margin-top: 10px;
  font-size: 0.9rem;
  line-height: 1.4;
}

@media (max-width: 768px) {
  .header-content {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  
  .profile-header {
    margin-top: 20px;
  }
}
/* Collapsible front-page sections (research overview, selected publications) */
.collapsible-section {
  margin-top: 32px;
}

.collapsible-section > summary {
  cursor: pointer;
  list-style: none;
  display: flex;
  align-items: center;
  gap: 10px;
}

.collapsible-section > summary::-webkit-details-marker {
  display: none;
}

.collapsible-section > summary h2 {
  margin: 0;
}

.collapsible-section > summary::after {
  content: "\25B8"; /* right-pointing triangle; rotates down when open */
  color: var(--global-text-color-light);
  font-size: 1.1rem;
  transition: transform 0.15s ease;
}

.collapsible-section[open] > summary::after {
  transform: rotate(90deg);
}

.collapsible-section .section-body {
  margin-top: 14px;
}

.research-overview {
  border-left: 3px solid var(--global-theme-color);
  padding: 4px 0 4px 18px;
}

.research-overview .section-body p {
  line-height: 1.6;
  margin-bottom: 14px;
}

.research-overview .section-body p:last-child {
  margin-bottom: 0;
}

.research-overview .overview-topic {
  font-weight: 600;
  color: var(--global-text-color);
}

.all-publications-link {
  margin-top: 8px;
  font-size: 0.95rem;
}

@media (prefers-reduced-motion: reduce) {
  .collapsible-section > summary::after {
    transition: none;
  }
}
</style>
<div class="post">
  <header class="post-header">
    <div class="header-content">
      <div class="title-section">
        <h1 class="post-title">
          {% if site.title == 'blank' %}
            <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
            {{ site.last_name }}
          {% else %}
            {{ site.title }}
          {% endif %}
        </h1>
        {% if page.subtitle %}<p class="desc">{{ page.subtitle }}</p>{% endif %}
        <div class="contact-info">
          <p><strong>Contact:</strong> chooper@berkeley.edu</p>
          <p><strong>Research Interests:</strong> Efficient LLM Inference, AI Systems, Model Compression</p>
          <p class="bio-text">I received my PhD from UC Berkeley in ML Systems, advised by Professors Kurt Keutzer in Berkeley AI Research (BAIR) and Sophia Shao in SLICE Lab (Computer Architecture group). I work on full-stack optimization for LLM inference, spanning efficient algorithms, ML systems, and architecture for ML.</p>
        </div>
      </div>
      {% if page.profile %}
        <div class="profile profile-header float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
          {% if page.profile.image %}
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            {% if page.profile.image_circular %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
            {% else %}
              {% assign profile_image_class = 'img-fluid z-depth-1
        rounded' %}
            {% endif %}
            {% if page.profile.image_width %}
              {% assign profile_image_style = 'width: ' | append: page.profile.image_width | append: '; max-width: 100%; height: auto;' %}
            {% else %}
              {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
        30vw, 95vw"{% endcapture %}
            {% endif %}
            {%
              include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
              cache_bust=true style=profile_image_style
            %}
          {% endif %}
          {% if page.profile.more_info %}
            <div class="more-info">{{ page.profile.more_info }}</div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </header>

  <article>

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Research overview -->
    {% if page.research_overview %}
      {% include research_overview.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <details class="collapsible-section selected-publications">
        <summary><h2>selected publications</h2></summary>
        <div class="section-body">
          {% include selected_papers.liquid %}
          <p class="all-publications-link"><a href="{{ '/publications/' | relative_url }}">See all publications &rarr;</a></p>
        </div>
      </details>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
